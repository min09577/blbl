<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <View
        android:id="@+id/touch_gesture_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/btn_touch_lock"
        android:layout_width="@dimen/player_touch_lock_button_size"
        android:layout_height="@dimen/player_touch_lock_button_size"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="@dimen/player_touch_lock_margin_start"
        android:background="?attr/blblFocusBgRound"
        android:contentDescription="@string/player_touch_lock"
        android:focusable="false"
        android:padding="@dimen/player_touch_lock_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_player_unlock"
        android:visibility="gone"
        android:tint="@color/player_button_tint" />

    <!-- v4.3: 长按倍速指示器 -->
    <LinearLayout
        android:id="@+id/boost_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/boost_indicator_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_ff"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tv_boost_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- v4.4: 手势方向指示器 - Seek (左侧) -->
    <LinearLayout
        android:id="@+id/gesture_seek_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/boost_indicator_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gesture_seek_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/gesture_seek_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- v4.4: 手势方向指示器 - 亮度/音量 (左侧) -->
    <LinearLayout
        android:id="@+id/gesture_vertical_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/boost_indicator_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gesture_vertical_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="#FFFFFF" />

        <ProgressBar
            android:id="@+id/gesture_vertical_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressTint="#FFFFFF"
            android:progressBackgroundTint="#55FFFFFF" />

        <TextView
            android:id="@+id/gesture_vertical_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- v10.1: 网络速度指示器 -->
    <TextView
        android:id="@+id/tv_network_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="#88000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- v10.2: 视频书签标记 -->
    <TextView
        android:id="@+id/tv_bookmark_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:background="#88FF8800"
        android:drawablePadding="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- v12.12: 电池电量指示器 -->
    <TextView
        android:id="@+id/tv_battery_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="#88000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- v12.25: 视频质量指示器 -->
    <TextView
        android:id="@+id/tv_video_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:background="#88000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
