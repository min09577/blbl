<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1A1A1A">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDownloadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="下载管理" />

        <ImageView
            android:id="@+id/btnDeleteAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_video_card_delete"
            android:scaleType="centerInside"
            android:contentDescription="全部删除"
            android:padding="8dp"
            android:focusable="true" />

    </LinearLayout>

    <!-- 存储信息 -->
    <TextView
        android:id="@+id/tvStorageInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF" />

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/tvEmptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="暂无下载记录\n在播放器设置中可以下载视频"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:padding="48dp"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <!-- 下载列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDownloads"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
