# Auto-detect text files and normalize line endings to LF
*           text=auto

# Source code
*.kt        text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.kts       text eol=lf
*.properties text eol=lf

# Documentation
*.md        text eol=lf
*.yml       text eol=lf
*.json      text eol=lf

# Shell scripts (must be LF)
*.sh        text eol=lf
gradlew     text eol=lf

# Binary files
*.jar       binary
*.aar       binary
*.apk       binary
*.png       binary
*.jpg       binary
*.ico       binary
*.so        binary
*.keystore  binary
*.dex       binary
*.class     binary
